# Haven Housesits Mobile — Environment Variables
# Copy to .env and fill in your values

# ── API ───────────────────────────────────────────────────────────────────────
# For local dev (Expo Go on device, use your machine's LAN IP):
EXPO_PUBLIC_API_URL="http://192.168.1.X:3002/api"

# For production:
# EXPO_PUBLIC_API_URL="https://havensits.com/api"

# ── EAS ───────────────────────────────────────────────────────────────────────
# Set in eas.json, not here. See eas.json for build profiles.
