{
  "expo": {
    "name": "Haven Housesits",
    "slug": "haven-housesits",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#5BA4A4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.havenhousesits.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Haven uses your location to show nearby house sits.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Haven uses your location to show nearby house sits.",
        "NSPhotoLibraryUsageDescription": "Haven needs access to your photos to upload profile and listing photos.",
        "NSCameraUsageDescription": "Haven needs camera access to take profile and listing photos.",
        "NSPhotoLibraryAddUsageDescription": "Haven saves photos to your library.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "YOUR_IOS_GOOGLE_MAPS_KEY"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5BA4A4"
      },
      "package": "com.havenhousesits.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_ANDROID_GOOGLE_MAPS_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Haven needs access to your photos to upload profile and listing photos.",
          "cameraPermission": "Haven needs camera access to take photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Haven uses your location to show nearby house sits."
        }
      ],
      "expo-font"
    ],
    "scheme": "havenhousesits",
    "updates": {
      "url": "https://u.expo.dev/YOUR_EAS_PROJECT_ID"
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      },
      "privacyPolicyUrl": "https://havensits.com/privacy",
      "termsUrl": "https://havensits.com/terms",
      "supportEmail": "support@havensits.com"
    }
  }
}
